@model ProductCatalogPrac6.Models.Product

@{
    ViewBag.Title = "Product Description";
}

<h2>Product Description</h2>

<img src="@Model.Image" alt="@Model.Name" style="width:300px; height:220px; object-fit:cover; border-radius:6px;" />
<br />
<br />

<table border="1" cellpadding="8">
    <tr>
        <th>Product ID</th>
        <th>Product Name</th>
        <th>Description</th>
        <th>Price</th>
        <th>Category</th>
    </tr>
    <tr>
        <td>@Model.Id</td>
        <td>@Model.Name</td>
        <td>@Model.Description</td>
        <td>₹@Model.Price</td>
        <td>@Model.Category</td>
    </tr>
</table>

<br />
@Html.ActionLink("Back to Product Catalog", "Index", "ProductCatalog")