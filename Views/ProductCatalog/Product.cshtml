@model List<ProductCatalogPrac6.Models.Product>

@{
    ViewBag.Title = "Product Catalog";
}

<h2>Product Catalog</h2>

<table border="1" cellpadding="8">
    <tr>
        <th>Product ID</th>
        <th>Product Name</th>
        <th>Description</th>
        <th>Price</th>
        <th>Category</th>
        <th>Action</th>
    </tr>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Id</td>
            <td>@item.Name</td>
            <td>@item.Description</td>
            <td>₹@item.Price</td>
            <td>@item.Category</td>
            <td>@Html.ActionLink("View Details", "Details", "ProductCatalog", new { id = item.Id }, null)</td>
        </tr>
    }
</table>
